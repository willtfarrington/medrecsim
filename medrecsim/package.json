{
  "name": "medrecsim-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "medrecsim workspace root — a fully synthetic medication-reconciliation training simulation (code MIT, content CC BY 4.0)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.14.1 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @medrecsim/app run dev",
    "build": "pnpm --filter @medrecsim/app run build",
    "preview": "pnpm --filter @medrecsim/app run preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "test": "vitest run",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "check:no-network": "node scripts/check-no-network.mjs",
    "check:spdx": "node scripts/check-spdx.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:action-pins": "node scripts/check-action-pins.mjs",
    "check:dco": "node scripts/check-dco.mjs",
    "check:layers": "node scripts/check-layer-separation.mjs",
    "checks": "pnpm run check:budget && pnpm run check:no-network && pnpm run check:spdx && pnpm run check:claims && pnpm run check:action-pins && pnpm run check:layers",
    "notices": "node scripts/gen-third-party.mjs",
    "content": "node packages/content-tools/src/cli.ts",
    "content:validate": "node packages/content-tools/src/cli.ts validate --all",
    "content:fixtures": "node packages/content-tools/src/cli.ts fixtures",
    "content:compile": "node packages/content-tools/src/cli.ts compile",
    "schema:export": "node packages/content-tools/src/cli.ts schema-export",
    "schema:check": "node packages/content-tools/src/cli.ts schema-export --check",
    "content:ci": "pnpm run content:validate --format github && pnpm run content:fixtures --format github && pnpm run schema:check && pnpm run content:compile",
    "verify": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run content:ci && pnpm run build && pnpm run checks"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
