{
  "name": "@medrecsim/schema",
  "version": "0.0.0",
  "private": true,
  "description": "medrecsim content schema: Zod 4 types + validators + core invariant suite (EP-9, D-DATA-003)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./evidence": "./src/evidence/index.ts",
    "./reference": "./src/reference/index.ts",
    "./documents": "./src/documents/index.ts",
    "./vocab": "./src/vocab/index.ts",
    "./version": "./src/version.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.evidence.json",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
