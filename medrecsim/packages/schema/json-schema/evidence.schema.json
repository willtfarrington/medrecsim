                        "minLength": 1,
                        "description": "Drug class or non-formulary agent as stated, e.g. \"penicillins\""
                      }
                    },
                    "required": [
                      "kind",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "The agent an allergy claim is about"
              },
              "reactionText": {
                "description": "Reaction as stated",
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "type": "string",
                "enum": [
                  "mild",
                  "moderate",
                  "severe",
                  "anaphylaxis",
                  "unknown"
                ]
              },
              "onsetTimingText": {
                "description": "When it happened, as stated",
                "type": "string",
                "minLength": 1
              },
              "priorToleranceText": {
