                  }
                ],
                "description": "When the source recorded it; never before eventTime"
              },
              "asStatedText": {
                "type": "string",
                "minLength": 1,
                "description": "Verbatim wording the learner sees from this source"
              },
              "agent": {
                "oneOf": [
                  {
                    "type": "object",
