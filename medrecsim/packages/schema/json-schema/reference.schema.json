              "target",
              "action",
              "shortfallText"
            ],
            "additionalProperties": false,
            "description": "Partially accepted action"
          }
        },
        "unsafe": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^act-[a-z0-9]+(?:-[a-z0-9]+)*$",
