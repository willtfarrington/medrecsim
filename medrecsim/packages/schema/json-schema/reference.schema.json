                  "discrepancyId": {
                    "type": "string",
                    "pattern": "^disc-[a-z0-9]+(?:-[a-z0-9]+)*$",
                    "description": "Discrepancy id"
                  }
                },
                "additionalProperties": false,
                "description": "The medication and/or discrepancy the action is about"
              },
              "action": {
                "type": "string",
                "enum": [
                  "continue",
                  "hold",
                  "needs-decision",
                  "escalate",
                  "propose-with-rationale",
                  "unable-to-verify",
                  "defer-with-plan"
                ]
              },
              "rationaleKey": {
                "description": "Key into rationaleMenu (preferred)",
                "type": "string",
                "pattern": "^rat-[a-z0-9]+(?:-[a-z0-9]+)*$"
              },
              "rationaleText": {
                "description": "Inline rationale when no menu item fits; still linted",
                "type": "string",
                "minLength": 1
              },
              "citations": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^cit-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}$",
                  "description": "Citation record id: cit- + short source slug + year"
                },
                "description": "Citation ids (must resolve in citations.yaml)"
              },
              "scoring": {
                "default": "scored",
                "type": "string",
                "enum": [
                  "scored",
                  "discussion-item-not-scored"
                ]
              },
              "freezeNoteText": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text"
              },
              "mechanismOfHarm": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Plausible-consequence phrasing with ordinal severity; no probabilities (D-SCOR-003)"
                  },
                  "inevitabilityAuthored": {
                    "default": false,
                    "description": "Set true only when the author deliberately states an inevitable harm; the lint otherwise rejects \"will\"/\"always\" wording",
                    "type": "boolean"
                  },
                  "citations": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^cit-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}$",
