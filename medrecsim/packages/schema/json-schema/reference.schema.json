          "citations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^cit-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}$",
              "description": "Citation record id: cit- + short source slug + year"
            },
            "description": "Every teaching note cites (policy §4)"
          }
        },
        "required": [
          "id",
          "anchor",
          "title",
          "summaryText",
          "citations"
        ],
        "additionalProperties": false,
        "description": "Teaching-note reference"
      }
    }
  },
  "required": [
    "schemaVersion",
    "caseId",
    "referenceRegimen",
    "actualUseState",
    "discrepancies",
    "actionSets"
  ],
  "additionalProperties": false,
  "description": "reference.yaml — author-only reference layer"
