    "expectedEscalations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^exp-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Expected escalation id"
          },
          "channelId": {
            "type": "string",
            "pattern": "^esc-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "The evidence-layer channel definition"
          },
          "required": {
            "type": "boolean",
            "description": "true = scored as expected; false = accepted but not required"
          },
          "whyText": {
            "type": "string",
            "minLength": 1,
            "description": "Why the escalation is expected (plausible-consequence phrasing)"
          },
          "byTime": {
            "description": "Latest simulated time by which it should be initiated",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^T0(?:[+-]\\d+(?:mo|y|w|d|h|m))*$",
                "description": "Time relative to admission T0, e.g. T0-2y, T0-3d-4h, T0+30m"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
                "description": "Absolute ISO-8601 date-time with UTC offset, e.g. 2026-01-15T14:30:00-05:00"
              }
            ]
          },
          "discrepancyIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^disc-[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Discrepancy id"
            }
          },
          "citations": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^cit-[a-z0-9]+(?:-[a-z0-9]+)*-\\d{4}$",
              "description": "Citation record id: cit- + short source slug + year"
            },
            "description": "Citation ids (must resolve in citations.yaml)"
          }
        },
        "required": [
          "id",
          "channelId",
          "required",
          "whyText"
        ],
        "additionalProperties": false,
        "description": "Expected escalation"
      }
    },
    "hints": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^hint-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Hint id"
          },
          "targetDiscrepancyId": {
            "type": "string",
            "pattern": "^disc-[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "Discrepancy id"
          },
          "nudge": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "description": "Grade 1: a gentle pointer"
          },
          "directed": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text"
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": false,
            "description": "Grade 2: names the kind of evidence to seek"
          },
          "revealSource": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "description": "Non-empty text"
              },
              "sourceRef": {
                "type": "string",
                "pattern": "^(source|claim|allergy-claim|dialogue-node|artifact|escalation-channel):([a-z][a-z0-9]*(?:-[a-z0-9]+)*)$",
                "description": "The evidence unit the reveal points at"
              }
            },
            "required": [
              "text",
              "sourceRef"
            ],
            "additionalProperties": false,
            "description": "Grade 3: reveals where to look"
          }
        },
        "required": [
          "id",
          "targetDiscrepancyId",
          "nudge",
          "directed",
          "revealSource"
        ],
        "additionalProperties": false,
        "description": "Graduated hint (nudge → directed → reveal-source; never score-subtracting)"
      }
    },
    "teachingNoteRefs": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tn-[a-z0-9]+(?:-[a-z0-9]+)*$",
