#!/bin/sh
# medrecsim pre-commit hook (EP-0, D-SEC-001, D-ROAD-002).
# Activated via: git config core.hooksPath githooks
# Layer 1: gitleaks v8 secret scan of staged changes (fails closed if the
#          binary is missing — install with: winget install Gitleaks.Gitleaks).
# Layer 2: tripwire grep — staged .local/ paths; MRN/SSN/DOB-like patterns;
#          mimic/physionet markers in path names or data-like files.
# Server-side push protection (EP-1) is the backstop, never the primary.

set -u

repo_root=$(git rev-parse --show-toplevel) || exit 1

fail() {
    printf '\n[pre-commit] COMMIT BLOCKED: %s\n' "$1" >&2
    printf '[pre-commit] Fix or unstage the offending content and retry.\n' >&2
    printf '[pre-commit] Synthetic fixtures belong under synthetic-fixtures/ with a "# SYNTHETIC" header.\n' >&2
    exit 1
}

# ---------------------------------------------------------------- layer 1 --
gitleaks_bin=$(command -v gitleaks 2>/dev/null || true)
if [ -z "$gitleaks_bin" ] && [ -n "${LOCALAPPDATA:-}" ] && \
   [ -x "$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe" ]; then
    gitleaks_bin="$LOCALAPPDATA/Microsoft/WinGet/Links/gitleaks.exe"
fi
if [ -z "$gitleaks_bin" ]; then
    fail "gitleaks not found. This hook fails closed. Install gitleaks v8 (winget install Gitleaks.Gitleaks) and retry."
fi

"$gitleaks_bin" git --pre-commit --staged --redact --no-banner \
    --config "$repo_root/.gitleaks.toml" "$repo_root" \
    || fail "gitleaks flagged a potential secret in the staged changes (findings above, redacted)."

# ---------------------------------------------------------------- layer 2 --
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 2a. Private zone: no .local/ path may ever be staged (D-ROAD-002).
if printf '%s\n' "$staged" | grep -E '(^|/)\.local(/|$)' >/dev/null 2>&1; then
    fail ".local/ paths are staged. The private zone is never committed."
fi

# 2b. Restricted-dataset markers in file PATHS. Markdown is exempt: governance
#     docs legitimately discuss the MIMIC gate (e.g. docs/MIMIC-GATE.md, EP-4);
#     datasets and fixtures do not ship as .md.
if printf '%s\n' "$staged" | grep -vE '\.md$' | grep -iE 'mimic|physionet' >/dev/null 2>&1; then
    fail "staged file path contains a mimic/physionet marker (restricted datasets are forbidden, D-MIMIC-001)."
fi

# 2c. Content tripwires on staged blobs.
#     - MRN/SSN/DOB-like patterns: all staged text files, except files under
#       synthetic-fixtures/ whose staged content begins with a # SYNTHETIC header.
#     - mimic/physionet markers: data-like files only (governance docs discuss
#       the MIMIC gate legitimately; datasets/fixtures must not).
phi_re='[0-9]{3}-[0-9]{2}-[0-9]{4}|[Mm][Rr][Nn][ :#]*[0-9]{5,}|[Dd][Oo][Bb][ :=]+[0-9]{1,4}[/-][0-9]{1,2}[/-][0-9]{1,4}'
marker_re='[Mm][Ii][Mm][Ii][Cc]|[Pp][Hh][Yy][Ss][Ii][Oo][Nn][Ee][Tt]'

printf '%s\n' "$staged" | while IFS= read -r f; do
    blob=$(git show ":$f" 2>/dev/null) || continue

    case "$f" in
        *synthetic-fixtures/*)
            printf '%s\n' "$blob" | head -n 1 | grep -E '^# SYNTHETIC' >/dev/null 2>&1 \
                || fail "$f is under synthetic-fixtures/ but lacks the required '# SYNTHETIC' first-line header."
            continue
            ;;
    esac

    if printf '%s\n' "$blob" | grep -E "$phi_re" >/dev/null 2>&1; then
        fail "$f contains an MRN/SSN/DOB-like pattern. Real-looking identifiers are forbidden outside synthetic-fixtures/."
    fi

    case "$f" in
        *.csv|*.tsv|*.json|*.jsonl|*.ndjson|*.yaml|*.yml|*.txt|*.dat)
            if printf '%s\n' "$blob" | grep -E "$marker_re" >/dev/null 2>&1; then
                fail "$f (data-like file) contains a mimic/physionet marker (D-MIMIC-001)."
            fi
            ;;
    esac
done || exit 1

exit 0
